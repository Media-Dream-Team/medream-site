# Google Sheets integration
# Base64-encoded service account JSON key
GOOGLE_SERVICE_ACCOUNT_KEY=
# The spreadsheet ID from the sheet URL
GOOGLE_SHEET_ID=
# Site URL for sitemap generation
SITE_URL=https://www.medream-studio.com

# Notion CMS (blog)
# Internal integration token, from the Notion integration created for this site
NOTION_API_KEY=
# Database ID for "Blog Posts", from its Notion URL — /p/<this-id>
NOTION_BLOG_DATABASE_ID=
